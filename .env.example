# Postgres
DATABASE_URL=postgresql://USER@localhost:5432/quire

# API
QUIRE_API_PORT=4000
QUIRE_WEB_ORIGIN=http://localhost:3000
QUIRE_SESSION_SECRET=change-me-to-32-plus-random-characters
QUIRE_STORAGE_DIR=./storage

# AI (all model calls go through Flint). Leave blank to run rule-only passes.
ANTHROPIC_API_KEY=
QUIRE_MODEL_CHEAP=claude-haiku-5-5
QUIRE_MODEL_STRUCTURAL=claude-sonnet-5-5
# Hard platform-wide daily inference cap, integer cents. Fails closed.
QUIRE_PLATFORM_SPEND_CAP_CENTS_DAILY=2000

# Discovery providers: comma list. "amazon" hits live Amazon autocomplete; "sample" is offline.
QUIRE_DISCOVERY_PROVIDERS=amazon   # amazon (live amazon.com) | sample
# Rank provider: "sample" only (deterministic, offline). Live rank data needs a licensed source.
QUIRE_RANK_PROVIDER=sample   # sample | amazon (scrapes amazon.com daily)

# Web
QUIRE_API_URL=http://localhost:4000
